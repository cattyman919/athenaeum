# --- Ports / runtime ---
APP_ENV=dev                      # dev | prod
API_PORT=8080
WEB_ORIGIN=http://localhost:3000

# --- PostgreSQL (pgvector image) ---
DATABASE_URL=postgres://athenaeum:athenaeum@localhost:5432/athenaeum?sslmode=disable

# --- Redis 7 ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Auth ---
JWT_ACCESS_SECRET=change-me-32-bytes-min
JWT_REFRESH_SECRET=change-me-too-32-bytes-min
ACCESS_TTL=15m
REFRESH_TTL=168h
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ISSUER=https://accounts.google.com   # override only for tests

# --- AI providers ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
WHISPER_BASE_URL=http://localhost:9000   # faster-whisper service (voice input, docs/15)
WHISPER_MODEL=small                      # multilingual; larger = slower on CPU
WHISPER_PARTIAL_BASE_URL=http://localhost:9001   # whisper-fast for live partials; empty → WHISPER_BASE_URL
WHISPER_FAST_MODEL=base                  # smaller/faster model for live (interim) partials

# --- Open Library metadata ---
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_BASE_URL=https://covers.openlibrary.org  # cover images cached into Postgres (book_covers)
OFFLINE_MODE=false               # true -> skip all outbound HTTP metadata fetches

# --- Seed ---
SEED_ADMIN_EMAIL=admin@athenaeum.dev
SEED_ADMIN_PASSWORD=athenaeum-demo
SEED_USER_EMAIL=demo@athenaeum.dev
SEED_USER_PASSWORD=athenaeum-demo
